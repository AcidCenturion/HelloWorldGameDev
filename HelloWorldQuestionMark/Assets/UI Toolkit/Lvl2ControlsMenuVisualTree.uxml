<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Lvl2PauseMenuStyle.uss?fileID=7433441132597879392&amp;guid=1bbf3285f817f31498845f8da86634d9&amp;type=3#Lvl2PauseMenuStyle" />
    <ui:VisualElement name="Container" style="flex-grow: 1;">
        <ui:VisualElement name="PauseBorder" style="flex-grow: 1; position: absolute; width: 480px; height: 480px; top: 120px; left: 320px; background-image: url(&quot;project://database/Packages/com.unity.2d.sprite/Editor/ObjectMenuCreation/DefaultAssets/Textures/Square.png?fileID=7482667652216324306&amp;guid=48e93eef0688c4a259cb0eddcd8661f7&amp;type=3#Square&quot;); -unity-background-image-tint-color: rgb(84, 59, 34); border-top-left-radius: 45px; border-top-right-radius: 45px; border-bottom-right-radius: 45px; border-bottom-left-radius: 45px;" />
        <ui:VisualElement name="PauseBackground" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.unity.2d.sprite/Editor/ObjectMenuCreation/DefaultAssets/Textures/Square.png?fileID=7482667652216324306&amp;guid=48e93eef0688c4a259cb0eddcd8661f7&amp;type=3#Square&quot;); opacity: 1; position: absolute; width: 460px; height: 460px; -unity-text-align: upper-left; top: 130px; left: 330px; visibility: visible; right: 0; bottom: 0; -unity-background-image-tint-color: rgb(249, 235, 203); border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px;">
            <ui:Label text="CONTROLS" name="CONTROLS" style="-unity-font-definition: url(&quot;project://database/Assets/Sprites/Level02/BoldPixels.otf?fileID=12800000&amp;guid=27807f321328bae478842e770c23f8b7&amp;type=3#BoldPixels&quot;); font-size: 81px; -unity-text-align: upper-center; color: rgb(84, 59, 34); margin-top: 16px; margin-bottom: 46px;" />
            <ui:Label text="Move — WASD" name="Move" class="controlsText" />
            <ui:Label text="Shoot — Space" name="Shoot" class="controlsText" />
            <ui:Label text="Pause — ESC" name="ESC" enable-rich-text="true" class="controlsText" />
            <ui:Button name="BackButton" class="button" style="background-image: url(&quot;project://database/Assets/Sprites/Level02/BackButton.png?fileID=-2970073484504309273&amp;guid=ff31e823ec94d0542a0e92dee559559d&amp;type=3#BackButton_0&quot;); margin-top: 48px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
