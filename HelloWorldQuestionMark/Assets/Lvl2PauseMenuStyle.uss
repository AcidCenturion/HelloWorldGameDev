.button {
    background-size: 100% 100%;
    position: relative;
    flex-direction: column;
    flex-basis: auto;
    width: 319px;
    height: 87px;
    align-items: stretch;
    align-self: center;
    align-content: flex-start;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-position-x: left 0;
    background-position-y: top 0;
    -unity-background-scale-mode: stretch-to-fill;
    border-top-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.button:hover {
    scale: 1.05 1.05;
    -unity-background-image-tint-color: rgb(253, 196, 120);
    transition-duration: 0.35s;
}

.controlsText {
    color: rgb(84, 59, 34);
    -unity-text-align: upper-left;
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/Sprites/Level02/BoldPixels.otf?fileID=12800000&guid=27807f321328bae478842e770c23f8b7&type=3#BoldPixels");
    margin-left: 80px;
    margin-top: -17px;
}
